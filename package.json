    "deepseek-harness",
    "dsh",
    "plugin",
    "jobs",
    "notification"
  ],
  "exports": {
    ".": "./index.js",
    "./notice": "./notice.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
